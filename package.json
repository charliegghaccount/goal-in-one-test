{
  "name": "goal-in-one",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "solve": "tsx tests/solve.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:pages": "npm run build -- --base=/goal-in-one-test/",
    "deploy:pages": "npm run build:pages && node scripts/publish-pages.mjs"
  },
  "dependencies": {
    "matter-js": "0.20.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/matter-js": "0.20.2",
    "@types/node": "22.19.15",
    "prettier": "3.6.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
